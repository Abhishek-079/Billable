# ---------- Required ----------
# Trustless Work API key (testnet). Get one at https://dapp.trustlesswork.com/
# Server-side only: never prefix with NEXT_PUBLIC_.
TW_API_KEY=
TW_BASE_URL=https://dev.api.trustlesswork.com

# Platform account: receives the platform fee and resolves disputes.
# `npm run platform-setup` creates it, funds it, adds USDC, and fills this in for you.
NEXT_PUBLIC_PLATFORM_ADDRESS=

# ---------- Storage ----------
# Postgres connection string. Required when deployed (e.g. a Neon "pooled" connection string).
# Leave empty locally to use a JSON file in ./data instead.
DATABASE_URL=

# ---------- Disputes (server only) ----------
# Secret key of the platform account (from .platform-secret). Needed to resolve disputes.
PLATFORM_SECRET=
# Password for the /admin page. At least 12 characters. Admin is disabled if this is empty or short.
ADMIN_TOKEN=

# ---------- Optional ----------
# strict = reject anything we can't confirm on the network (default in production)
# warn   = accept but flag it as unverified (default in development)
# off    = skip checks
# VERIFY_TX=strict

# Platform fee in percent (Trustless Work also charges its own 0.3% on release)
NEXT_PUBLIC_PLATFORM_FEE=1

# Testnet USDC issuer (Circle). Override to use a different test asset.
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Shown on the home page if set: a service where users can cash USDC out to rupees.
# NEXT_PUBLIC_CASHOUT_URL=
# NEXT_PUBLIC_CASHOUT_NAME=

# Where the JSON-file storage keeps data (defaults to ./data)
# DATA_DIR=
